# ─── Kalamio API — Environment Variables ───
# Copy this file to .env and fill in values

# ── Required ──────────────────────────────────
DB_LOCATION=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Optional (have defaults) ─────────────────
# PORT=8080
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173

# ── Google OAuth (optional — enables Google sign-in) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=/api/auth/google/callback

# ─── Response caching (optional) ───
# Upstash Redis REST credentials. If unset, response caching is disabled and the
# API behaves normally. Get these from the Upstash console (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare origin lock (optional) ───
# Set to a long random string that matches a Cloudflare Transform Rule adding
# `X-Origin-Secret: <value>`. Blocks requests that bypass Cloudflare. Unset = off.
CLOUDFLARE_ORIGIN_SECRET=
